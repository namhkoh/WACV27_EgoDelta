{
  "description": "Fast target-relative right-knife deleafing phases with MPS orientation, RealSense tip checks, and explicit rigid-stake clearance.",
  "version": 3,
  "defaults": {
    "teleop_prior_json": "robot/kinematics/runs/052726/deleaf_teleop_prior/a270c038_deleaf_safe_demo_01_priors.json",
    "teleop_prior_library_dir": "robot/kinematics/runs/060326/deleaf_teleop_prior",
    "successful_demo_library": "robot/policy/policy_action_library",
    "successful_demo_seed_count": 5,
    "toolfit": "robot/calibration/tooltips/a270c038_right_knife_tip_edge_deleaf_01.json",
    "waypoint_policy": "mps_template",
    "task_orientation_policy": "teleop_pre_cut",
    "stroke_axis_policy": "downward_constrained",
    "max_stroke_tilt_deg": 8.0,
    "max_z_m": 1.35,
    "execute_until": "return_transit",
    "transit_lift_m": 0.55,
    "transit_lift_time_s": 8.0,
    "safe_entry_lift_m": 0.04,
    "safe_entry_standoff_m": 0.12,
    "pre_cut_standoff_m": 0.035,
    "approach_stroke_standoff_m": 0.04,
    "target_extension_m": 0.0,
    "target_extension_values_m": "0",
    "contact_advance_mode": "entry",
    "use_pointcloud_candidates": true,
    "pointcloud_contact_advance_values_m": "0.07",
    "pointcloud_candidate_angles_deg": "-35,0,35",
    "approach_azimuth_sweep_deg": "0,-30,-60,-90,30,60,90",
    "adaptive_approach_azimuth_top_k": 3,
    "pointcloud_min_clearance_m": 0.015,
    "pointcloud_blade_min_clearance_m": 0.0,
    "pointcloud_cut_exclusion_m": 0.035,
    "pointcloud_path_samples": 8,
    "cut_through_m": 0.015,
    "pre_cut_time_s": 0.5,
    "cut_time_s": 0.04,
    "cut_velocity_limit_rad_s": 4.0,
    "cut_acceleration_limit_rad_s2": 18.0,
    "post_cut_lift_m": 0.07,
    "post_cut_lift_time_s": 4.0,
    "return_transit_lift_m": 0.55,
    "return_transit_time_s": 8.0
  }
}
